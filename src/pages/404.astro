    <div class="wrap" style="text-align:center; padding-block: 80px;">
      <span class="kicker">Ошибка 404</span>
      <h1>Страница не найдена</h1>
      <p class="lead">Возможно, она была перемещена или удалена.</p>
      <a class="btn" href="/">Вернуться на главную</a>
    </div>
  </section>
</Base>
