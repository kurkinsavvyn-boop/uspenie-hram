---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((n) => ({ params: { slug: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const gallery = n.data.gallery ?? [];
---

<Base title={`${n.data.title} — Храм Успения Пресвятой Богородицы в Челюскинском`} description={n.data.excerpt ?? n.data.title}>
  <section class="page">
    <div class="wrap">
      <article class="article">
        <span class="kicker">{fmt.format(n.data.date)}</span>
        <h1>{n.data.title}</h1>

        {n.data.image && <img class="article-main" src={n.data.image} alt={n.data.title} />}

        <Content />

        {gallery.length > 0 && (
          <section class="photogallery">
            <h2>Фотогалерея</h2>
            <div class="carousel">
              <div class="carousel-track">
                {gallery.map((g) => <img src={g} alt={n.data.title} loading="lazy" />)}
              </div>
              {gallery.length > 1 && (
                <>
                  <button class="carousel-btn prev" type="button" aria-label="Предыдущее фото">‹</button>
                  <button class="carousel-btn next" type="button" aria-label="Следующее фото">›</button>
                </>
              )}
            </div>
          </section>
        )}

        <p><a href="/novosti/">← Все новости</a></p>
      </article>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll('.carousel').forEach((car) => {
    const track = car.querySelector('.carousel-track');
    const prev = car.querySelector('.carousel-btn.prev');
    const next = car.querySelector('.carousel-btn.next');
    if (!track) return;
    const step = () => {
      const img = track.querySelector('img');
      return img ? img.clientWidth + 12 : 320;
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>
