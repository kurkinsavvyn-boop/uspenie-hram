---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import calendar from '../data/calendar.json';
import { getCollection } from 'astro:content';
import ornHtml from '../components/orn.html?raw';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long' });
const calDays = JSON.stringify(calendar.days);
---

<Base description="Официальный сайт храма Успения Пресвятой Богородицы в посёлке Челюскинский. Расписание богослужений, новости прихода, таинства и требы, воскресная школа.">
  <section class="hero-row">
    <div class="hero-head">
      <p class="over">
        <span>Сергиево-Посадская епархия</span><i> · </i><span>Ивантеевское благочиние</span>
      </p>
      <h1>Храм Успения Пресвятой Богородицы</h1>
      <p class="sub">в Челюскинском</p>
    </div>

    <div class="hero-service">
      <Fragment set:html={ornHtml} />

      <section class="vA" id="svc">
        <h2>Ближайшая служба</h2>
        <div id="svc-day" class="vA-day wd">
          <p class="vA-date"><b>—</b><span class="vA-wd"></span></p>
          <div>
            <p class="vA-f" id="svc-feast"></p>
            <ul><li><time>—</time><span>—</span></li></ul>
          </div>
        </div>
        <div class="acts">
          <a class="btn solid" href="/zapiski/">Подать записку</a>
          <a class="btn" href="/raspisanie/">Всё расписание</a>
        </div>
      </section>
    </div>

    <figure class="hero-pic">
      <div class="drawing" id="hram-draw">
        <canvas class="cv" aria-hidden="true"></canvas>
        <img class="fin" src="/images/hram-watercolor.webp" alt="Храм Успения Пресвятой Богородицы в Челюскинском — акварель" width="1280" height="1229" fetchpriority="high" />
      </div>
    </figure>
  </section>

  <section class="news" id="news">
    <div class="sec-h">
      <h2><a href="/novosti/">Новости</a></h2>
      <a class="more" href="/novosti/">Все новости →</a>
    </div>
    <div class="news-l">
      {news.map((n) => (
        <article>
          {n.data.image && <img src={n.data.image} alt="" loading="lazy" width="900" height="675" />}
          <time datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
          <h3>{n.data.title}</h3>
          <p>{n.data.excerpt}</p>
          <a href={`/novosti/${n.id}/`}>Подробнее</a>
        </article>
      ))}
    </div>
  </section>

  <div class="uzb" data-img="/images/ornaments/uzor-izumrud.png" style="--h:30px;--rules:var(--red)" aria-hidden="true"></div>

  <section class="about" id="about">
    <div>
      <h2><a href="/istoriya/">О храме</a></h2>
      <p class="lead"><span class="cap" aria-hidden="true"></span><span class="sr">П</span>ервый молебен в посёлке Челюскинский прошёл 28 августа 2005 года — на Успение Пресвятой Богородицы. Через год была создана община, а в 2011-м заложен каменный храм.</p>
      <p>При храме действует воскресная школа, приход совершает паломнические поездки и общие добрые дела. Двери храма открыты для всех: приходите, будем рады!</p>
      <a class="more" href="/istoriya/">История храма →</a>
    </div>
    <ul class="facts">
      <li style="--i:0"><b>2005</b>первая служба, 28 августа</li>
      <li style="--i:1"><b>2006</b>создана община, назначен настоятель</li>
      <li style="--i:2"><b>2010</b>освящён и установлен Крест</li>
      <li style="--i:3"><b>2011</b>закладка храма</li>
      <li style="--i:4"><b>2014</b>увенчан куполами и крестами</li>
    </ul>
  </section>

  <div class="uzb" data-img="/images/ornaments/uzor-izumrud.png" style="--h:30px;--rules:var(--red)" aria-hidden="true"></div>

  <section class="help" id="help">
    <div>
      <h2><a href="/pomoch/">Помощь храму</a></h2>
      <p class="lead"><span class="cap cap-h" aria-hidden="true"></span><span class="sr">Х</span>рам содержит приход и благотворители. Пожертвования помогают совершать богослужения, содержать храм и вести духовно-просветительскую работу.</p>
      <div class="htxt">
        <i class="qsp" aria-hidden="true"></i>
        <figure class="quote" id="quote">
          <canvas class="cv" aria-hidden="true"></canvas>
          <img class="fin" src="/images/ornaments/zaamvonnaya-ink.webp" alt="Освяти любящия благолепие дому Твоего, Ты тех воспрослави Божественною Твоею силою. Заамвонная молитва." width="1100" height="795" decoding="async" />
        </figure>
        <p>Перевести пожертвование можно по реквизитам, по QR-коду в приложении банка или оставить в церковной лавке. Приход всегда рад и помощи делом.</p>
      </div>
    </div>
    <div class="req" id="rekvizity">
      <h3>Реквизиты <span class="tbc">уточнить</span></h3>
      <dl>
        <dt>Получатель</dt>
        <dd>Приход Успенской церкви пос. Челюскинский</dd>
        <dt>Назначение</dt>
        <dd>Добровольное пожертвование</dd>
        <dt>Уточнить</dt>
        <dd>в церковной лавке или по телефону</dd>
      </dl>
      <p class="give"><a class="btn solid" href="/pomoch/">Помочь храму</a></p>
    </div>
  </section>

  <script type="application/json" id="svc-data" set:html={calDays}></script>
</Base>

<script>
  // Ближайшая служба по московскому времени из календаря.
  // Служба считается прошедшей через 60 минут после начала.
  (function () {
    const el = document.getElementById('svc-day');
    if (!el) return;
    const dataEl = document.getElementById('svc-data');
    let days = [];
    try { days = JSON.parse(dataEl.textContent); } catch (e) { return; }
    const msk = new Date(Date.now() + 3 * 3600e3);
    const nowMs = msk.getTime();
    const baseMs = Date.UTC(msk.getUTCFullYear(), msk.getUTCMonth(), msk.getUTCDate());
    const curDay = msk.getUTCDate();
    const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
    let found = null;
    for (const d of days) {
      const dayMs = baseMs + (d.day - curDay) * 86400e3;
      for (const ev of d.events) {
        for (const s of ev.services) {
          const [hh, mm] = s[0].split(':').map(Number);
          const svcMs = dayMs + (hh * 60 + mm) * 60e3;
          if (svcMs + 3600e3 > nowMs) { found = { d, ev, s }; break; }
        }
        if (found) break;
      }
      if (found) break;
    }
    if (!found) { el.remove(); return; }
    const { d, ev, s } = found;
    el.querySelector('.vA-date b').textContent = d.day + ' ' + MONTHS[msk.getUTCMonth()];
    el.querySelector('.vA-wd').textContent = d.wd;
    const f = el.querySelector('.vA-f');
    if (f) f.textContent = ev.feast || '';
    el.querySelector('ul').innerHTML = '<li><time>' + s[0] + '</time><span>' + s[1] + '</span></li>';
  })();
</script>

<script>
  // Прорисовывание акварели храма: мягкая кисть слева направо, потом проявляется оригинал
  (function () {
    const box = document.getElementById('hram-draw');
    if (!box) return;
    const cv = box.querySelector('.cv'), fin = box.querySelector('.fin');
    const done = () => { box.classList.add('done'); if (fin) fin.style.opacity = 1; };
    if (!cv || !fin || !cv.getContext || matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }
    const load = (src) => new Promise((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = no; i.src = src; });
    load(fin.getAttribute('src')).then(run).catch(done);
    function run(img) {
      if (!img.naturalWidth) { done(); return; }
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const W = Math.max(1, Math.round(box.clientWidth * dpr));
      const H = Math.max(1, Math.round(W * img.naturalHeight / img.naturalWidth));
      cv.width = W; cv.height = H;
      const ctx = cv.getContext('2d');
      const mk = (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
      const imgC = mk(W, H), mask = mk(W, H);
      const ic = imgC.getContext('2d'), mc = mask.getContext('2d');
      ic.drawImage(img, 0, 0, W, H);
      const R = Math.max(12, W / 18);
      let t0 = null; const DUR = 2.8;
      fin.style.transition = 'opacity 1s ease';
      fin.style.opacity = 0;
      function frame(ts) {
        if (t0 === null) t0 = ts;
        const s = Math.min(1, (ts - t0) / 1000 / DUR);
        const x = s * (W + R);
        mc.clearRect(0, 0, W, H);
        if (x > R) { mc.fillStyle = '#000'; mc.fillRect(0, 0, x - R, H); }
        if (x > 0) {
          const g = mc.createLinearGradient(x - R, 0, x, 0);
          g.addColorStop(0, 'rgba(0,0,0,1)'); g.addColorStop(1, 'rgba(0,0,0,0)');
          mc.fillStyle = g; mc.fillRect(Math.max(0, x - R), 0, R, H);
        }
        ctx.clearRect(0, 0, W, H);
        ctx.drawImage(imgC, 0, 0);
        ctx.globalCompositeOperation = 'destination-in';
        ctx.drawImage(mask, 0, 0);
        ctx.globalCompositeOperation = 'source-over';
        if (s < 1) requestAnimationFrame(frame); else done();
      }
      requestAnimationFrame(frame);
    }
  })();
</script>

<script>
  // Прорисовывание каллиграфии «Заамвонная молитва» — строки «прописываются» кистью
  (function () {
    const fig = document.getElementById('quote');
    if (!fig) return;
    const cv = fig.querySelector('.cv'), fin = fig.querySelector('.fin');
    const done = () => { fig.classList.add('done'); if (fin) fin.style.opacity = 1; };
    if (!cv || !fin || !cv.getContext || matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }
    const IW = 1100, IH = 795, SPEED = 1150, GAP = 0.12;
    const LINES = [[95, 262, 150, 975], [250, 355, 105, 995], [348, 455, 90, 930], [448, 565, 40, 1055], [575, 670, 15, 1095]];
    const load = (src) => new Promise((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = no; i.src = src; });
    const mk = (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
    load(fin.getAttribute('src')).then(run).catch(done);
    function run(img) {
      if (!img.naturalWidth) { done(); return; }
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const W = Math.max(1, Math.round(fig.clientWidth * dpr)), H = Math.round(W * IH / IW), k = W / IW;
      cv.width = W; cv.height = H;
      const ctx = cv.getContext('2d');
      const mask = mk(W, H), L = mk(W, H);
      const mctx = mask.getContext('2d'), lctx = L.getContext('2d');
      let t0 = null, END = 0.3, t = 0.15;
      const plan = [];
      LINES.forEach((l) => { const d = (l[3] - l[2]) / SPEED; plan.push({ l, s: t, d, x: l[2] }); t += d + GAP; });
      END = t;
      fin.style.transition = 'opacity .9s ease';
      fin.style.opacity = 0;
      function dab(x, y, r) {
        const g = mctx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, 'rgba(0,0,0,1)'); g.addColorStop(0.62, 'rgba(0,0,0,.85)'); g.addColorStop(1, 'rgba(0,0,0,0)');
        mctx.fillStyle = g; mctx.fillRect(x - r, y - r, 2 * r, 2 * r);
      }
      function frame(ts) {
        if (t0 === null) t0 = ts;
        const s = (ts - t0) / 1000;
        plan.forEach((q) => {
          if (s < q.s) return;
          const l = q.l, to = l[2] + (l[3] - l[2]) * Math.min(1, (s - q.s) / q.d);
          const r = (l[1] - l[0]) * 0.56 * k, cy = (l[0] + l[1]) / 2 * k;
          for (let x = q.x; x <= to; x += r / (3 * k)) dab(x * k, cy + Math.sin(x * 0.05) * 3 * k, r);
          q.x = Math.max(q.x, to);
        });
        lctx.clearRect(0, 0, W, H);
        lctx.globalCompositeOperation = 'source-over';
        lctx.drawImage(img, 0, 0, W, H);
        lctx.globalCompositeOperation = 'destination-in';
        lctx.drawImage(mask, 0, 0);
        ctx.clearRect(0, 0, W, H);
        ctx.drawImage(L, 0, 0);
        if (s < END + 0.1) requestAnimationFrame(frame); else done();
      }
      requestAnimationFrame(frame);
    }
  })();
</script>
