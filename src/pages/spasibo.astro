---
import Base from '../layouts/Base.astro';
---

<Base title="Спасибо — Храм Успения Пресвятой Богородицы в Челюскинском">
  <section class="page">
    <div class="wrap">
      <div class="page-head">
        <span class="kicker">Записка</span>
        <h1>Спасибо!</h1>
        <p class="lead">Записка принята, платёж обрабатывается. Священник помянет имена за богослужением.</p>
        <div class="hero-actions" style="margin-top:22px">
          <a class="btn solid" href="/">На главную</a>
          <a class="btn" href="/zapiski/">Подать ещё</a>
        </div>
      </div>
    </div>
  </section>
</Base>
