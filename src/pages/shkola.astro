---
import Base from '../layouts/Base.astro';
import ornHtml from '../components/orn.html?raw';

const photos = [
  '2020-02.jpg', '2020-06.jpg', '2020-09.jpg',
  'g7-03.jpg', '20-03-29-01.jpg', '20-01-19-02.jpg',
];
---

<Base title="Воскресная школа — Храм Успения Пресвятой Богородицы в Челюскинском" description="Воскресная школа храма Успения Пресвятой Богородицы в Челюскинском: занятия, хор, творчество и поездки.">
  <section class="phead">
    <h1>Воскресная школа</h1>
    <p class="lead">К Богу с детства: занятия, хор, творчество и поездки.</p>
  </section>

  <Fragment set:html={ornHtml} />

  <div class="wrap" style="padding-block: clamp(24px, 4vw, 44px);">
    <div class="prose">
      <p class="lead">Воскресная школа Успенского храма помогает детям знакомиться с православной верой, Священным Писанием, историей Церкви и церковным пением.</p>
      <h2>Занятия</h2>
      <ul>
        <li>Закон Божий и основы православной веры;</li>
        <li>Священная история Ветхого и Нового Завета;</li>
        <li>Церковное пение и хор;</li>
        <li>Творческие занятия и рукоделие.</li>
      </ul>
      <p>Воспитанники школы участвуют в богослужениях, праздничных концертах, паломнических поездках и спортивных состязаниях — Спартакиаде воскресных школ и «Сергиевских играх».</p>
      <p class="note">Записать ребёнка в воскресную школу и узнать расписание занятий можно по телефону храма или в церковной лавке.</p>
    </div>

    <div class="gallery" style="margin-top: clamp(20px, 3vw, 36px);">
      {photos.map((p) => (
        <figure><img src={`/images/gallery/${p}`} alt="Жизнь прихода" loading="lazy" /></figure>
      ))}
    </div>
  </div>
</Base>
